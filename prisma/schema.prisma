generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STANDARD
  MANAGER
  ADMINISTRATOR
}

enum ItemFieldType {
  TEXT
  INTEGER
  DECIMAL
  SELECT
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AuditAction {
  PART_CREATED
  PART_DELETED
  PART_FIELD_UPDATED
  PROJECT_CREATED
  PROJECT_ARCHIVED
  CATEGORY_CREATED
  CATEGORY_DELETED
  SUBCATEGORY_CREATED
  SUBCATEGORY_DELETED
  VENDOR_CREATED
  VENDOR_DEACTIVATED
  VENDOR_REACTIVATED
  LOCATION_CREATED
  LOCATION_DEACTIVATED
  LOCATION_REACTIVATED
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PROMOTED
  USER_DEMOTED
  TEAM_PASSWORD_CHANGED
}

model SystemSettings {
  id               Int      @id @default(1)
  teamPasswordHash String
  updatedAt        DateTime @updatedAt
}

model User {
  id        Int      @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  type      Role     @default(STANDARD)
  firstName String
  lastName  String
  pwdHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  projectsCreated      Project[]             @relation("ProjectCreatedBy")
  checkoutsCreated     ProjectCheckout[]     @relation("CheckoutCheckedOutBy")
  checkoutsModified    ProjectCheckout[]     @relation("CheckoutModifiedBy")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentUser")
  auditLogs            AuditLog[]            @relation("AuditLogPerformedBy")

  @@unique([firstName, lastName])
}

model Category {
  id           Int                   @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  name         String                @unique
  parentId     Int?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  items        Item[]
  nameTemplate String?
  itemFields   ItemFieldDefinition[]
  createdAt    DateTime              @default(now())

  @@unique([name, parentId])
}

model Item {
  id              Int                   @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  name            String
  partNumber      String                @unique
  description     String
  categoryId      Int
  category        Category              @relation(fields: [categoryId], references: [id])
  vendorId        Int
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  locationId      Int?
  location        StorageLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  material        String?
  quantity        Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  checkouts       ProjectCheckout[]
  adjustments     InventoryAdjustment[]
  itemFieldValues ItemFieldValue[]

  @@index([categoryId])
  @@index([partNumber])
  @@index([vendorId])
  @@index([locationId])
}

model ItemFieldDefinition {
  id         Int              @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  categoryId Int
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       ItemFieldType
  required   Boolean          @default(false)
  unit       String?
  options    Json?
  sortOrder  Int              @default(0)
  active     Boolean          @default(true)
  values     ItemFieldValue[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model ItemFieldValue {
  id                Int                 @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  itemId            Int
  item              Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fieldDefinitionId Int
  fieldDefinition   ItemFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  value             String

  @@unique([itemId, fieldDefinitionId])
  @@index([itemId])
  @@index([fieldDefinitionId])
}

model Vendor {
  id        Int      @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  name      String   @unique
  active    Boolean  @default(true)
  items     Item[]
  createdAt DateTime @default(now())
}

model StorageLocation {
  id        Int               @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  name      String            @unique
  active    Boolean           @default(true)
  parentId  Int?
  parent    StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  StorageLocation[] @relation("StorageLocationTree")
  items     Item[]
  createdAt DateTime          @default(now())
}

model InventoryAdjustment {
  id               Int      @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  itemId           Int
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantityDelta    Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  adjustedById     Int
  adjustedBy       User     @relation("InventoryAdjustmentUser", fields: [adjustedById], references: [id])
  createdAt        DateTime @default(now())

  @@index([itemId])
  @@index([adjustedById])
}

model Project {
  id            Int               @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  name          String            @unique
  description   String?
  status        ProjectStatus     @default(ACTIVE)
  checkouts     ProjectCheckout[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  archivedAt    DateTime?
  createdById   Int
  createdByUser User              @relation("ProjectCreatedBy", fields: [createdById], references: [id])
}

model AuditLog {
  id     Int         @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  action AuditAction

  entityId   Int?
  entityName String
  summary    String
  details    Json?

  performedById Int
  performedBy   User @relation("AuditLogPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entityId])
  @@index([performedById])
  @@index([createdAt])
}

model ProjectCheckout {
  id                 Int      @id @default(dbgenerated("floor(random() * 90000000 + 10000000)::int"))
  projectId          Int
  project            Project  @relation(fields: [projectId], references: [id])
  partId             Int
  part               Item     @relation(fields: [partId], references: [id])
  quantityCheckedOut Int
  note               String?
  checkedOutAt       DateTime @default(now())
  checkedOutById     Int
  checkedOutBy       User     @relation("CheckoutCheckedOutBy", fields: [checkedOutById], references: [id])
  lastModifiedAt     DateTime @updatedAt
  lastModifiedById   Int?
  lastModifiedBy     User?    @relation("CheckoutModifiedBy", fields: [lastModifiedById], references: [id])

  @@unique([projectId, partId])
  @@index([projectId])
  @@index([partId])
}
